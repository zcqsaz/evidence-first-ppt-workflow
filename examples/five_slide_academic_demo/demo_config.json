{
  "$schema": "../../schemas/project_config.schema.json",
  "schema_version": "1.0.0",
  "workflow_version": "1.0.2",
  "project": {
    "id": "example-five-slide-academic-demo",
    "name": "Evidence-First 五页学术PPT制作示例",
    "type": "course",
    "language": "zh-CN"
  },
  "scope": {
    "allowed_files": [
      "five_slide_academic_demo.pptx",
      "build_demo.py",
      "demo_config.json",
      "example_spec.md"
    ],
    "forbidden_files": [
      "institutional_template.pptx",
      "third_party_figures/",
      "private_inputs/"
    ]
  },
  "presentation": {
    "expected_slide_count": 5,
    "aspect_ratio": "16:9",
    "allowed_fonts": ["Microsoft YaHei"],
    "cover_slides": [1],
    "directory_slides": [2],
    "transition_slides": [],
    "page_number": {
      "required": true,
      "start_slide": 2,
      "center_tolerance_inches": 0.08
    },
    "banned_phrases": [
      "阅读要点",
      "课堂解读",
      "课堂观察",
      "理解要点",
      "案例定位",
      "课程示意",
      "图示所支持",
      "制作说明",
      "仅供 AI",
      "模块一",
      "模块二",
      "模块三"
    ]
  },
  "qa": {
    "fail_on_out_of_bounds": true,
    "fail_on_text_overlap": true,
    "fail_on_nonzero_picture_crop": true,
    "fail_on_duplicate_evidence_media": true,
    "fail_on_banned_phrase": true,
    "fail_on_explicit_disallowed_font": true,
    "fail_on_unmapped_evidence_media": false,
    "fail_on_low_density": false,
    "ignore_template_media_repeated_on_fraction": 0.8,
    "text_overlap_smaller_area_fraction": 0.08,
    "minimum_body_characters_without_visual": 120,
    "minimum_body_characters_with_visual": 80,
    "minimum_substantive_units": 4,
    "low_density_exempt_slides": [1, 2],
    "crop_exempt_slides": [],
    "overlap_exempt_slides": []
  }
}
