{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-first-ppt-workflow.local/schemas/source_metadata.schema.json",
  "title": "Evidence asset metadata row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "filename",
    "case_name",
    "ppt_page",
    "figure_title",
    "source_type",
    "source_organization",
    "source_title",
    "publication_year",
    "source_url",
    "license_or_usage_note",
    "verification_status"
  ],
  "properties": {
    "asset_id": {"type": "string"},
    "filename": {"type": "string", "minLength": 1},
    "case_name": {"type": "string", "minLength": 1},
    "ppt_page": {"type": ["string", "integer"], "pattern": "^([0-9]+([,; -][0-9]+)*)?$"},
    "figure_title": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_organization": {"type": "string", "minLength": 1},
    "source_title": {"type": "string", "minLength": 1},
    "publication_year": {"type": ["string", "integer"], "pattern": "^([12][0-9]{3}|n\\.d\\.)?$"},
    "figure_number": {"type": ["string", "integer"]},
    "page_number": {"type": ["string", "integer"]},
    "doi": {"type": "string"},
    "source_url": {"type": "string", "pattern": "^https?://"},
    "download_url": {"type": "string"},
    "access_method": {"type": "string"},
    "access_basis": {"type": "string"},
    "access_date_utc": {"type": "string", "format": "date-time"},
    "retrieval_route": {"type": "string"},
    "rights_status": {"type": "string"},
    "variable": {"type": "string"},
    "time_coverage": {"type": "string"},
    "spatial_extent": {"type": "string"},
    "unit": {"type": "string"},
    "product_nature": {"type": "string"},
    "license_or_usage_note": {"type": "string", "minLength": 1},
    "verification_status": {"type": "string", "minLength": 1},
    "file_sha256": {"type": "string", "pattern": "^([A-Fa-f0-9]{64})?$"},
    "notes": {"type": "string"}
  }
}
